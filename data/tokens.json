{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens read back from the Figma library 'Shadcn Components' (version 2026-08-27). `source: figma` values were resolved through the Figma MCP; `source: derived` values could not be read with the available token scope.",
  "meta": {
    "figmaFile": "https://www.figma.com/community/file/1342715840824755935/shadcn-ui-components-with-variables-tailwind-classes-updated-august-2026",
    "figmaFileName": "Shadcn Components",
    "figmaLastModified": "2026-08-27T14:00:43Z",
    "collections": {
      "mode": "semantic shadcn tokens (colour + radius), 2 modes: light / dark",
      "rdx/colors": "Radix colour scales — source of the chart palette",
      "tw/font": "family, size, weight, leading, tracking",
      "tw/gap": "spacing scale (gap-*, gap-x-*, gap-y-*)",
      "tw/border-radius": "raw Tailwind radii (rounded-*)",
      "tw/border-width": "border-*, border-{t,r,b,l,s,e}-*",
      "tw/max-height": "max-h-*",
      "tw/min-height": "min-h-*"
    },
    "baseColor": "tailwind neutral",
    "fontFamily": "Inter"
  },

  "color": {
    "background":                 { "$type": "color", "light": "#ffffff", "dark": "#0a0a0a", "source": { "light": "figma", "dark": "derived" } },
    "foreground":                 { "$type": "color", "light": "#0a0a0a", "dark": "#fafafa", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-950" },
    "card":                       { "$type": "color", "light": "#ffffff", "dark": "#171717", "source": { "light": "figma", "dark": "derived" } },
    "card-foreground":            { "$type": "color", "light": "#0a0a0a", "dark": "#fafafa", "source": { "light": "figma", "dark": "derived" } },
    "popover":                    { "$type": "color", "light": "#ffffff", "dark": "#262626", "source": { "light": "figma", "dark": "derived" } },
    "popover-foreground":         { "$type": "color", "light": "#0a0a0a", "dark": "#fafafa", "source": { "light": "figma", "dark": "derived" } },
    "primary":                    { "$type": "color", "light": "#171717", "dark": "#e5e5e5", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-900" },
    "primary-foreground":         { "$type": "color", "light": "#fafafa", "dark": "#171717", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-50" },
    "secondary":                  { "$type": "color", "light": "#f5f5f5", "dark": "#262626", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-100" },
    "secondary-foreground":       { "$type": "color", "light": "#0a0a0a", "dark": "#fafafa", "source": { "light": "figma", "dark": "derived" } },
    "muted":                      { "$type": "color", "light": "#f5f5f5", "dark": "#262626", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-100" },
    "muted-foreground":           { "$type": "color", "light": "#737373", "dark": "#a1a1a1", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-500" },
    "accent":                     { "$type": "color", "light": "#f5f5f5", "dark": "#404040", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-100" },
    "accent-foreground":          { "$type": "color", "light": "#171717", "dark": "#fafafa", "source": { "light": "derived", "dark": "derived" }, "note": "mirrors sidebar-accent-foreground, which was readable" },
    "destructive":                { "$type": "color", "light": "#e7000b", "dark": "#ff6467", "source": { "light": "figma", "dark": "derived" }, "tailwind": "red-600" },
    "destructive-foreground":     { "$type": "color", "light": "#fafafa", "dark": "#fafafa", "source": { "light": "derived", "dark": "derived" } },
    "text-destructive":           { "$type": "color", "light": "#e7000b", "dark": "#ff6467", "source": { "light": "figma", "dark": "derived" }, "note": "library-specific token; used for destructive text and icons" },
    "destructive-subtle":         { "$type": "color", "light": "#e7000b1a", "dark": "#ff64671f", "source": { "light": "figma", "dark": "derived" }, "note": "library-specific token; 10% tint behind destructive badges, menu items and media tiles" },
    "border":                     { "$type": "color", "light": "#e5e5e5", "dark": "#ffffff1a", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-200" },
    "input":                      { "$type": "color", "light": "#e5e5e5", "dark": "#ffffff26", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-200" },
    "ring":                       { "$type": "color", "light": "#737373", "dark": "#737373", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-500" },

    "chart-1":                    { "$type": "color", "light": "#5eb1ef", "dark": "#2870bd", "source": { "light": "figma", "dark": "derived" }, "radix": "blue/8" },
    "chart-2":                    { "$type": "color", "light": "#0090ff", "dark": "#0090ff", "source": { "light": "figma", "dark": "derived" }, "radix": "blue/9" },
    "chart-3":                    { "$type": "color", "light": "#0588f0", "dark": "#3b9eff", "source": { "light": "figma", "dark": "derived" }, "radix": "blue/10" },
    "chart-4":                    { "$type": "color", "light": "#0d74ce", "dark": "#70b8ff", "source": { "light": "figma", "dark": "derived" }, "radix": "blue/11" },
    "chart-5":                    { "$type": "color", "light": "#113264", "dark": "#c2e6ff", "source": { "light": "figma", "dark": "derived" }, "radix": "blue/12" },

    "sidebar":                    { "$type": "color", "light": "#fafafa", "dark": "#171717", "source": { "light": "figma", "dark": "derived" }, "tailwind": "neutral-50" },
    "sidebar-foreground":         { "$type": "color", "light": "#0a0a0a", "dark": "#fafafa", "source": { "light": "figma", "dark": "derived" } },
    "sidebar-primary":            { "$type": "color", "light": "#171717", "dark": "#e5e5e5", "source": { "light": "figma", "dark": "derived" } },
    "sidebar-primary-foreground": { "$type": "color", "light": "#fafafa", "dark": "#171717", "source": { "light": "figma", "dark": "derived" } },
    "sidebar-accent":             { "$type": "color", "light": "#f5f5f5", "dark": "#262626", "source": { "light": "figma", "dark": "derived" } },
    "sidebar-accent-foreground":  { "$type": "color", "light": "#171717", "dark": "#fafafa", "source": { "light": "figma", "dark": "derived" } },
    "sidebar-border":             { "$type": "color", "light": "#e5e5e5", "dark": "#ffffff1a", "source": { "light": "figma", "dark": "derived" } },
    "sidebar-ring":               { "$type": "color", "light": "#737373", "dark": "#737373", "source": { "light": "derived", "dark": "derived" } }
  },

  "radius": {
    "$description": "Figma stores absolute px in the `mode` collection; `radius-lg` is the anchor and everything else is an offset from it, exactly like shadcn's --radius formula.",
    "base":  { "$type": "dimension", "$value": "10px", "css": "--radius", "source": "figma" },
    "none":  { "$type": "dimension", "$value": "0px",  "formula": "0",              "source": "figma" },
    "xs":    { "$type": "dimension", "$value": "4px",  "formula": "base - 6px",     "source": "derived" },
    "sm":    { "$type": "dimension", "$value": "6px",  "formula": "base - 4px",     "source": "figma" },
    "md":    { "$type": "dimension", "$value": "8px",  "formula": "base - 2px",     "source": "figma" },
    "lg":    { "$type": "dimension", "$value": "10px", "formula": "base",           "source": "figma" },
    "xl":    { "$type": "dimension", "$value": "14px", "formula": "base + 4px",     "source": "figma" },
    "2xl":   { "$type": "dimension", "$value": "18px", "formula": "base + 8px",     "source": "figma" },
    "3xl":   { "$type": "dimension", "$value": "22px", "formula": "base + 12px",    "source": "figma" },
    "4xl":   { "$type": "dimension", "$value": "26px", "formula": "base + 16px",    "source": "figma" },
    "full":  { "$type": "dimension", "$value": "9999px", "source": "figma" }
  },

  "typography": {
    "family": { "sans": { "$type": "fontFamily", "$value": "Inter", "source": "figma" } },
    "size": {
      "xs":  { "$type": "dimension", "$value": "12px", "lineHeight": "16px", "source": "figma" },
      "sm":  { "$type": "dimension", "$value": "14px", "lineHeight": "20px", "source": "figma" },
      "base":{ "$type": "dimension", "$value": "16px", "lineHeight": "24px", "source": "figma" },
      "lg":  { "$type": "dimension", "$value": "18px", "lineHeight": "28px", "source": "figma" },
      "xl":  { "$type": "dimension", "$value": "20px", "lineHeight": "28px", "source": "figma" },
      "2xl": { "$type": "dimension", "$value": "24px", "lineHeight": "32px", "source": "figma" },
      "3xl": { "$type": "dimension", "$value": "30px", "lineHeight": "36px", "source": "figma" },
      "4xl": { "$type": "dimension", "$value": "36px", "lineHeight": "40px", "source": "figma" }
    },
    "weight": {
      "thin": 100, "extralight": 200, "light": 300, "normal": 400, "medium": 500,
      "semibold": 600, "bold": 700, "extrabold": 800, "black": 900
    },
    "tracking": { "normal": { "$type": "dimension", "$value": "0", "source": "figma" } },
    "styles": {
      "$description": "Figma ships Text-{xs|sm|base|lg|xl|2xl|3xl|4xl}/{Thin…Black} as text styles — every size crossed with every weight, 72 styles. In code these are Tailwind pairs, e.g. `text-sm font-medium`."
    }
  },

  "shadow": {
    "xs":                { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.10)", "figmaStyle": "Box Shadow/shadow-xs", "source": "figma" },
    "md":                { "$type": "shadow", "$value": "0 2px 4px -2px rgb(0 0 0 / 0.10), 0 4px 6px -1px rgb(0 0 0 / 0.10)", "figmaStyle": "Box Shadow/shadow-md", "source": "figma" },
    "lg":                { "$type": "shadow", "$value": "0 4px 6px -4px rgb(0 0 0 / 0.10), 0 10px 15px -3px rgb(0 0 0 / 0.10)", "figmaStyle": "Box Shadow/shadow-lg", "source": "figma" },
    "focus-ring":        { "$type": "shadow", "$value": "0 0 0 3px #a1a1a180", "figmaStyle": "Box Shadow/Focus ring", "source": "figma", "note": "neutral-400 @ 50%; NOT the `ring` token" },
    "focus-ring-destructive": { "$type": "shadow", "$value": "0 0 0 3px #dc262633", "figmaStyle": "Box Shadow/Destructive", "source": "figma", "note": "red @ 20%" }
  },

  "borderWidth": {
    "default": { "$type": "dimension", "$value": "1px", "source": "figma" },
    "2":       { "$type": "dimension", "$value": "2px", "source": "figma" }
  },

  "icon": {
    "size":        { "$type": "dimension", "$value": "16px", "source": "figma", "note": "default glyph box inside controls" },
    "strokeWidth": { "$type": "number", "$value": 2, "source": "figma", "note": "stroke-1 (1px) is used inside Command, Calendar and Sidebar" },
    "library":     { "$value": "lucide", "note": "Tabler, HugeIcons, Phosphor and Remix are also published in the file — see docs/icons.md" }
  },

  "opacity": {
    "disabled": { "$type": "number", "$value": 0.5, "source": "figma", "note": "figma variable `opacity: 0.5`" }
  }
}
